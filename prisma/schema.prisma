generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}
enum UserStatus {
  ACTIVE
  SUSPENDED
  PENDING_VERIFICATION
}
enum OrderStatus {
  PENDING
  SUBMITTING
  SUBMISSION_UNKNOWN
  PROCESSING
  IN_PROGRESS
  COMPLETED
  PARTIAL
  CANCELED
  FAILED
}
enum DepositStatus {
  PENDING
  PAID
  EXPIRED
  FAILED
  CANCELED
}
enum LedgerType {
  DEPOSIT
  ORDER_DEBIT
  REFUND
  ADJUSTMENT
}
enum LedgerStatus {
  POSTED
  REVERSED
}
enum PaymentEventStatus {
  RECEIVED
  VERIFIED
  PROCESSED
  REJECTED
}
enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

model User {
  id             String       @id @default(cuid())
  username       String       @unique @db.VarChar(32)
  email          String       @unique @db.VarChar(254)
  passwordHash   String
  role           Role         @default(USER)
  status         UserStatus   @default(PENDING_VERIFICATION)
  emailVerifiedAt DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  wallet         Wallet?
  sessions       Session[]
  orders         Order[]
  deposits       Deposit[]
  ledgerEntries  WalletLedger[]
  tickets        SupportTicket[]
  passwordTokens PasswordResetToken[]
  verifyTokens   EmailVerificationToken[]
  @@index([createdAt])
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, expiresAt])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, expiresAt])
}

model EmailVerificationToken {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, expiresAt])
}

model Wallet {
  id        String   @id @default(cuid())
  userId    String   @unique
  balance   BigInt   @default(0)
  currency  String   @default("IDR") @db.VarChar(3)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  ledgerEntries WalletLedger[]
}

model WalletLedger {
  id             String       @id @default(cuid())
  userId         String
  walletId       String
  transactionId  String       @unique
  type           LedgerType
  amount         BigInt
  balanceBefore  BigInt
  balanceAfter   BigInt
  referenceId    String?
  status         LedgerStatus @default(POSTED)
  idempotencyKey String       @unique
  reason         String?
  createdAt      DateTime     @default(now())
  user           User         @relation(fields: [userId], references: [id], onDelete: Restrict)
  wallet         Wallet       @relation(fields: [walletId], references: [id], onDelete: Restrict)
  transaction   Transaction  @relation(fields: [transactionId], references: [id], onDelete: Restrict)
  @@index([userId, createdAt])
  @@index([referenceId])
}

model Transaction {
  id          String   @id @default(cuid())
  userId      String
  type        LedgerType
  amount      BigInt
  currency    String   @default("IDR") @db.VarChar(3)
  status      String   @default("PENDING") @db.VarChar(32)
  referenceId String?
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  ledger      WalletLedger?
  @@index([userId, createdAt])
  @@index([referenceId])
}

model Provider {
  id          String   @id @default(cuid())
  name        String   @unique
  baseUrl     String
  isEnabled   Boolean  @default(false)
  lastSyncedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  services    Service[]
  @@index([isEnabled])
}

model Category {
  id        String    @id @default(cuid())
  name      String    @unique
  slug      String    @unique
  sortOrder Int       @default(0)
  isActive  Boolean   @default(true)
  services  Service[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Service {
  id              String   @id @default(cuid())
  providerId      String
  categoryId      String?
  providerServiceId String
  name            String
  description     String?
  baseRate        Decimal  @db.Decimal(18, 6)
  sellingRate     Decimal  @db.Decimal(18, 6)
  minQuantity     Int
  maxQuantity     Int
  refillSupported Boolean  @default(false)
  cancelSupported Boolean  @default(false)
  isActive        Boolean  @default(false)
  lastSyncedAt    DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  provider        Provider @relation(fields: [providerId], references: [id], onDelete: Restrict)
  category        Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  orders          Order[]
  @@unique([providerId, providerServiceId])
  @@index([categoryId, isActive])
  @@index([isActive, name])
}

model Order {
  id                String      @id @default(cuid())
  userId            String
  serviceId         String
  internalReference String      @unique
  providerOrderId   String?
  targetUrl         String
  quantity          Int
  charge            BigInt
  status            OrderStatus @default(PENDING)
  idempotencyKey    String
  providerResponse  Json?
  lastProviderCheckAt DateTime?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  user              User        @relation(fields: [userId], references: [id], onDelete: Restrict)
  service           Service     @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  statusHistory     OrderStatusHistory[]
  refunds           Refund[]
  @@unique([userId, idempotencyKey])
  @@index([userId, createdAt])
  @@index([status, updatedAt])
  @@index([providerOrderId])
}

model OrderStatusHistory {
  id        String      @id @default(cuid())
  orderId   String
  fromStatus OrderStatus?
  toStatus  OrderStatus
  source    String
  note      String?
  createdAt DateTime    @default(now())
  order     Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  @@index([orderId, createdAt])
}

model Deposit {
  id              String        @id @default(cuid())
  userId          String
  internalOrderId String        @unique
  idempotencyKey  String
  providerOrderId String?
  amount          BigInt
  feeAmount       BigInt        @default(0)
  currency        String        @default("IDR") @db.VarChar(3)
  status          DepositStatus @default(PENDING)
  paymentMethod   String?
  checkoutUrl     String?
  qrUrl           String?
  expiresAt       DateTime?
  paidAt          DateTime?
  providerPayload Json?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  user            User          @relation(fields: [userId], references: [id], onDelete: Restrict)
  @@unique([userId, idempotencyKey])
  @@index([userId, createdAt])
  @@index([status, createdAt])
}

model PaymentEvent {
  id            String             @id @default(cuid())
  provider      String
  providerEventId String?
  orderId       String
  payloadHash   String
  status        PaymentEventStatus @default(RECEIVED)
  receivedAt    DateTime           @default(now())
  processedAt   DateTime?
  failureReason String?
  @@unique([provider, providerEventId])
  @@unique([provider, payloadHash])
  @@index([orderId, receivedAt])
}

model Refund {
  id             String   @id @default(cuid())
  orderId        String
  amount         BigInt
  reason         String
  idempotencyKey String   @unique
  createdBy      String
  createdAt      DateTime @default(now())
  order          Order    @relation(fields: [orderId], references: [id], onDelete: Restrict)
  @@index([orderId])
}

model SupportTicket {
  id        String       @id @default(cuid())
  userId    String
  subject   String
  status    TicketStatus @default(OPEN)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  user      User         @relation(fields: [userId], references: [id], onDelete: Restrict)
  messages  SupportMessage[]
  @@index([userId, status])
}

model SupportMessage {
  id        String   @id @default(cuid())
  ticketId  String
  authorId  String
  body      String
  isAdmin   Boolean  @default(false)
  createdAt DateTime @default(now())
  ticket    SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  @@index([ticketId, createdAt])
}

model SiteSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  action     String
  targetType String
  targetId   String?
  metadata   Json?
  ipHash     String?
  createdAt  DateTime @default(now())
  @@index([actorId, createdAt])
  @@index([targetType, targetId])
}

model IdempotencyKey {
  id         String   @id @default(cuid())
  scope      String
  key        String
  requestHash String
  response   Json?
  createdAt  DateTime @default(now())
  expiresAt  DateTime
  @@unique([scope, key])
  @@index([expiresAt])
}
